# Copy to .env and fill in your values. Never commit .env.
# IDs may be separated by commas, spaces, ';' or newlines.

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456789:PASTE_YOUR_TELEGRAM_BOT_TOKEN

# Chats the bot moderates. If empty, the bot moderates ANY chat it is added to.
ALLOWED_CHAT_IDS=-1001234567890,-1009876543210

# Telegram user IDs allowed to use bot commands (in private chat only)
ADMIN_USER_IDS=123456789

# Extra users whose messages are never deleted (777000 is always included)
BYPASS_USER_IDS=

# Channels/chats whose "on behalf of" posts (sender_chat) are never deleted
BYPASS_SENDER_CHAT_IDS=-1001234567890,-1009876543210

# Set to 1 for verbose matching logs
ANTISPAM_DEBUG=0
